# Configuración del pipeline del cancionero
PDF_INPUT=CANCIONERO MJP - final imprimir.pdf
PAGINA_INICIO=10
TEMP_DIR=cancionero_temp
SALIDA=cancionero_completo.json

# Proveedor LLM: openai | google
LLM_PROVIDER=openai
# Modelo (ajustá según tu proveedor y plan)
LLM_MODEL=gpt-4o-mini

# Claves de API (una de ellas según el proveedor)
OPENAI_API_KEY=sk-tu_clave_aqui
GOOGLE_API_KEY=tu_clave_aqui
